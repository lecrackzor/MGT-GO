*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database files
*.db
*.db-shm
*.db-wal

# Ticker data directories
Tickers */

# PNG chart gallery (scripts/export_daily_charts.py default --out)
chart_gallery/

# Log files
*.log
logs/

# Settings (may contain sensitive data like API keys)
settings.yaml
settings.yml
*.yaml.bak
*.yml.bak

# Wails build output
app.exe
app
dist/

# Windows resource .syso (generated from winres/ + gex2.ico by go-winres make)
*.syso

# Profiling files
*.pb.gz
*.prof
pprof/

# ---------------------------------------------------------------------------
# Python ML sidecar (local-only — do not commit the side project)
# ---------------------------------------------------------------------------
ml/
scripts/
tests/

# Python bytecode / caches (any stray .py outside the dirs above)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Large ML artifacts if copied outside ml/ (e.g. manual backups)
*.joblib
*.parquet
optuna.db
optuna.db-journal
